# Copy to .env and fill in. .env is gitignored.
#
# Default points at the deployed cfilab proxy. For a local proxy use
# PROXY_BASE_URL=http://localhost:4000 instead.
PROXY_BASE_URL=https://litellm.cfilab.philips.com
LITELLM_API_KEY=sk-REPLACE-WITH-YOUR-VIRTUAL-KEY

# Set to False on networks with TLS interception (e.g. the Philips corporate
# proxy) so the HTTPS/WSS calls to the proxy don't fail certificate checks.
# Leave True anywhere you have a normal certificate chain.
SSL_VERIFY=False
